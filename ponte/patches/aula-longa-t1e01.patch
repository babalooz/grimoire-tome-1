+   "rotulo": "a cena",
+   "titulo": "o primeiro oi da Capy"
+  },
+  {
+   "ep": "episodes/cafe-t1e01-aula-explicacao.json",
+   "rotulo": "a explicação",
+   "titulo": "três palavras e um sopro"
+  },
+  {
+   "ep": "episodes/cafe-t1e01-aula-sua-vez.json",
+   "rotulo": "sua vez",
