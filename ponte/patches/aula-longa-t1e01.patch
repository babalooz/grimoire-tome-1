new file mode 100644
index 0000000..0644a67
--- /dev/null
+++ b/canal-idiomas/scripts/aula-wide.ts
@@ -0,0 +1,48 @@
+// AULA LONGA (YouTube 16:9, 8 a 12 min): mesma composição e agenda do longo do dia (src/DiaWide.tsx, src/wide/dia.ts),
+// com partes `cafe` escolhidas num roteiro de aula (aulas/<slug>.json), mais pausadas e didáticas. Rodado por scripts/make-aula-wide.sh.
+// Uso:
+//   node aula.cjs montar <aulas/slug.json>   -> out/props-aula-<slug>.json
+//   node aula.cjs capitulos <props.json>     -> linhas "00:00 ..." (sai 1 se quebrar regra do YouTube)
+//   node aula.cjs pacote <aulas/slug.json> <props.json> -> out/aula-<slug>.youtube.json
+import { readFileSync, writeFileSync } from "fs";
+import { DiaProps, diaCapitulos } from "../src/wide/dia";
+
+const FPS = 30;
+const [cmd, ...a] = process.argv.slice(2);
+const ler = (f: string) => JSON.parse(readFileSync(f, "utf8"));
+const cafeProps = (ep: string) => {
+  const e = ler(ep);
+  return { ...e, timings: ler(`public/audio/${e.id}/timings.json`), ...ler(`public/audio/${e.id}/mix.json`) };
+};
+
+if (cmd === "montar") {
+  const au = ler(a[0]);
+  const p: DiaProps = {
+    id: `aula-${au.slug}`,
+    data: au.data,
+    dataTexto: "aula completa", // a abertura escreve "inglês do básico, em episódios · aula completa"
+    partes: au.partes.map((x: any) => ({ tipo: "cafe" as const, rotulo: x.rotulo, titulo: x.titulo, props: cafeProps(x.ep) })),
+    recap: au.recap,
+    capitulos: { encerramento: "Revisão da aula" },
+  };
+  const out = `out/props-${p.id}.json`;
+  writeFileSync(out, JSON.stringify(p));
+  console.log(out);
+} else if (cmd === "capitulos") {
+  const c = diaCapitulos(ler(a[0]) as DiaProps, FPS);
+  c.linhas.forEach((l) => console.log(l));
+  console.error(`duração: ${c.total.toFixed(1)} s`);
+  if (c.problemas.length) { c.problemas.forEach((x) => console.error("CAPÍTULO: " + x)); process.exit(1); }
+} else if (cmd === "pacote") {
+  const au = ler(a[0]);
+  const p = ler(a[1]) as DiaProps;
+  const cap = diaCapitulos(p, FPS);
+  const descricao = [...au.descricao, "", "Capítulos:", ...cap.linhas, "", "#capyfala #inglês #inglesdozero"].join("\n");
+  const out = { titulo: au.titulo, descricao, categoriaId: "27", madeForKids: false, miniatura: `out/${p.id}.miniatura.png`, arquivo: `${p.id}.mp4`,
+    duracao: +cap.total.toFixed(1), capitulos: cap.linhas };
+  writeFileSync(`out/${p.id}.youtube.json`, JSON.stringify(out, null, 2));
+  console.log(`out/${p.id}.youtube.json (título ${au.titulo.length} car., descrição ${descricao.length} car.)`);
+} else {
+  console.error("uso: montar | capitulos | pacote");
+  process.exit(2);
+}
diff --git a/canal-idiomas/scripts/make-aula-wide.sh b/canal-idiomas/scripts/make-aula-wide.sh
new file mode 100644
index 0000000..e4456c8
--- /dev/null
+++ b/canal-idiomas/scripts/make-aula-wide.sh
@@ -0,0 +1,38 @@
+#!/usr/bin/env bash
+# AULA LONGA 16:9 (YouTube, 8 a 12 min): as partes de aulas/<slug>.json viram um vídeo só na composição DiaWide.
+# Voz: scripts/tts.py pede só o que não está no cache. Saída: out/aula-<slug>.mp4 (H.264, yuv420p/tv/bt709, −14 LUFS),
+# out/aula-<slug>.capitulos.txt, out/aula-<slug>.miniatura.png e, acima de 95 MB (limite por arquivo do GitHub é 100 MB),
+# out/aula-<slug>.mp4.part-* para o ramo midia (juntar com cat).
+# Depois: scripts/portao.py --dia out/props-aula-<slug>.json --juiz <nota>. Nunca sobe nem publica.
+# Uso: scripts/make-aula-wide.sh <slug> [--max-pedidos N] [--no-video]
+set -euo pipefail
+cd "$(dirname "$0")/.."
+SLUG="$1"; shift
+MAX=60; VIDEO=1
+while [ $# -gt 0 ]; do case "$1" in --max-pedidos) MAX="$2"; shift ;; --no-video) VIDEO=0 ;; esac; shift; done
+AULA="aulas/$SLUG.json"; ID="aula-$SLUG"
+BROWSER=/opt/pw-browsers/chromium_headless_shell-1194/chrome-linux/headless_shell
+BROWSER_FLAG=$([ -x "$BROWSER" ] && echo "--browser-executable=$BROWSER" || true)
+mkdir -p out
+
+for EP in $(node -e "require('./$AULA').partes.forEach(x=>console.log(x.ep))"); do
+  .venv/bin/python scripts/tts.py "$EP" --motor gemini --max-pedidos "$MAX"
+done
+
+JS=$(mktemp --suffix=.cjs)
+trap 'rm -f "$JS"' EXIT
+npx esbuild scripts/aula-wide.ts --bundle --platform=node --log-level=warning > "$JS"
+node "$JS" montar "$AULA" >/dev/null
+node "$JS" capitulos "out/props-$ID.json" > "out/$ID.capitulos.txt"
+cat "out/$ID.capitulos.txt"
+node "$JS" pacote "$AULA" "out/props-$ID.json"
+node -e "const a=require('./$AULA');require('fs').writeFileSync('out/props-$ID-miniatura.json',JSON.stringify(a.miniatura))"
+npx remotion still src/index.ts MiniaturaWide "out/$ID.miniatura.png" --props="out/props-$ID-miniatura.json" $BROWSER_FLAG >/dev/null
+
+if [ "$VIDEO" = 1 ]; then
+  npx remotion render src/index.ts DiaWide "out/$ID.mp4" --props="out/props-$ID.json" --audio-bitrate=320k --crf=22 --pixel-format=yuv420p --color-space=bt709 $BROWSER_FLAG
+  .venv/bin/python scripts/loudnorm.py "out/$ID.mp4"
+  rm -f "out/$ID.mp4.part-"*
+  [ "$(stat -c %s "out/$ID.mp4")" -le 95000000 ] || split -b 90M "out/$ID.mp4" "out/$ID.mp4.part-"
+  ls -l "out/$ID.mp4"*
+fi
