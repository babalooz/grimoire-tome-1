+  {
+   "speaker": "lazy",
+   "lang": "pt",
+   "emotion": "neutral",
+   "text": "Esse H é um sopro, igual vapor de café."
+  },
+  {
+   "speaker": "capi",
+   "lang": "pt",
+   "emotion": "happy",
+   "text": "Vamos juntos. Eu também tô aprendendo."
+  },
+  {
+   "speaker": "capi",
+   "lang": "en",
+   "emotion": "happy",
+   "alvo": true,
+   "vapor": true,
+   "text": "Hi! I'm Capy."
+  },
+  {
+   "speaker": "capi",
+   "lang": "en",
+   "emotion": "happy",
+   "alvo": true,
+   "vapor": true,
+   "repita": true,
+   "text": "Hi! I'm Capy."
+  },
+  {
+   "speaker": "lazy",
+   "lang": "en",
+   "emotion": "smile",
+   "alvo": true,
+   "vapor": true,
+   "text": "Hi! I'm Capy."
+  },
+  {
+   "speaker": "hank",
+   "lang": "pt",
+   "emotion": "neutral",
+   "text": "Com sotaque? Tudo bem. Deu pra entender."
